# ==============================================================================
# WeddingAlbums.in — Production Environment Variables
# ==============================================================================

# Server Port & Mode
PORT=4000
NODE_ENV=production

# Database: MongoDB Atlas Connection URI
# Example: mongodb+srv://admin:StrongPassword123@cluster0.abcde.mongodb.net/weddingalbums?retryWrites=true&w=majority
MONGODB_URI=

# Offline SQLite fallback path (optional)
SQLITE_DB_PATH=./weddingalbums.sqlite

# Security: JWT Secret (Generate a strong 64-char key in production)
JWT_SECRET=super_secret_wedding_key_2026_change_in_production

# Cloudinary / Storage (Optional for photo proofs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payments Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
