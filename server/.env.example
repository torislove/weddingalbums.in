# ==============================================================================
# WeddingAlbums.in — Production Environment Variables
# ==============================================================================

# Server Port & Mode
PORT=4000
NODE_ENV=production

# Database: PostgreSQL Connection URI (Supabase / Neon / RDS / Cloud SQL)
# Example: postgresql://postgres:StrongPassword123@localhost:5432/weddingalbums
DATABASE_URL=

# Offline / in-memory fallback path (optional; used when DATABASE_URL is unreachable)
SQLITE_DB_PATH=./weddingalbums.sqlite

# ------------------------------------------------------------------------------
# Security: JWT Secret  ⚠️ REQUIRED IN PRODUCTION  ⚠️
# The server now REFUSES to serve traffic in production while this is unset or
# left at the public development default (see server/config.js).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# For Firebase deploys, put this in server/.env.<projectId> (e.g. .env.weddingalbums-b4bcd),
# NOT here — files named `.env.<projectId>` are what the Firebase CLI uploads.
# ------------------------------------------------------------------------------
JWT_SECRET=

# Extra browser origins allowed to call the API (comma-separated), on top of the
# built-in localhost + *.web.app + *.weddingalbums.in allow-list. See server/index.js.
# CORS_ORIGINS=https://your-custom-domain.com,https://www.your-custom-domain.com

# Seeded admin password for server/seed.js (defaults to admin123 when unset)
# ADMIN_SEED_PASSWORD=

# Cloudinary / Storage (Optional for photo proofs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payments Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
