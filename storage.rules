rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Albums raw photos, designs, and previews: allowed images/PDF up to 100MB
    match /albums/{albumId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // General uploads: requires authenticated user, limited to 50MB of images, pdf, or video
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf|video/.*');
    }
  }
}
