{
  "functions": [
    {
      "source": "server",
      "codebase": "server",
      "ignore": [
        "node_modules",
        ".git",
        "uploads",
        ".env",
        ".env.local",
        ".env.development.local",
        ".env.test.local",
        ".env.production.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "client",
      "public": "client/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/studio{,/**}",
          "destination": "https://weddingalbums-studio.web.app",
          "type": 302
        },
        {
          "source": "/creator{,/**}",
          "destination": "https://weddingalbums-editor.web.app",
          "type": 302
        },
        {
          "source": "/editor{,/**}",
          "destination": "https://weddingalbums-editor.web.app",
          "type": 302
        },
        {
          "source": "/ops{,/**}",
          "destination": "https://weddingalbums-sysadmin.web.app",
          "type": 302
        },
        {
          "source": "/cms{,/**}",
          "destination": "https://weddingalbums-uiadmin.web.app",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "api"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/firebase-messaging-sw.js",
          "headers": [
            {
              "key": "Service-Worker-Allowed",
              "value": "/"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "studio",
      "public": "b2b-portal/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "api"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "editor",
      "public": "editor-portal/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "api"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "sysadmin",
      "public": "sysadmin/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "api"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "uiadmin",
      "public": "uiadmin/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "api"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
